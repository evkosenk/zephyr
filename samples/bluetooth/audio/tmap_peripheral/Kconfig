mainmenu "Bluetooth: Earbuds"

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

menu "Earbuds"

config TMAP_PERIPHERAL_AUDIO_JACK_MIC
	bool "Send EVKB microphone over LE Audio"
	depends on AUDIO && I2S
	help
	  Capture audio through the WM8962 on SAI1 RX, encode it as LC3 and send it
	  on the unicast source stream. Select the microphone input below.

if TMAP_PERIPHERAL_AUDIO_JACK_MIC

choice TMAP_PERIPHERAL_AUDIO_JACK_MIC_SOURCE
	prompt "Microphone input for LE Audio"
	default TMAP_PERIPHERAL_AUDIO_JACK_MIC_ONBOARD
	help
	  Select which WM8962 capture channel to send on the LE Audio source stream.

config TMAP_PERIPHERAL_AUDIO_JACK_MIC_ONBOARD
	bool "EVKB onboard microphone"
	help
	  Send the onboard microphone on the right channel.

config TMAP_PERIPHERAL_AUDIO_JACK_MIC_HEADSET
	bool "J101 headset microphone"
	help
	  Send the headset microphone on the left channel. Use an OMTP-wired headset.

endchoice

endif

config TMAP_PERIPHERAL_SET_RANK
	int "Device rank in set"
	depends on TMAP_PERIPHERAL_DUO
	range 1 2
	help
	  Rank of this device in set.

choice TMAP_PERIPHERAL_TYPE_CHOICE
	prompt "Earbuds type"
	help
	  Select the Earbuds Type to compile.

config TMAP_PERIPHERAL_SINGLE
	bool "Single ear headset"

config TMAP_PERIPHERAL_DUO
	depends on BT_CAP_ACCEPTOR_SET_MEMBER
	bool "Duo headset"

endchoice # TMAP_PERIPHERAL_TYPE_CHOICE

choice TMAP_PERIPHERAL_LOCATION
	prompt "Earbud Location"
	help
	  Select the Earbud location.

config TMAP_PERIPHERAL_LEFT
	bool "Left Ear"

config TMAP_PERIPHERAL_RIGHT
	bool "Right Ear"

endchoice # TMAP_PERIPHERAL_LOCATION

endmenu
